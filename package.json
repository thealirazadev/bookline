{
  "name": "bookline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:seed": "prisma db seed",
    "reminders:once": "tsx jobs/reminders.ts",
    "bench": "tsx scripts/benchmark.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "luxon": "3.7.2",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "next": {
      "postcss": "8.5.21",
      "sharp": "0.35.5"
    },
    "tinypool": "2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.1",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "10.6.2",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.29",
    "jsdom": "29.1.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
